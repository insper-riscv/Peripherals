#include <stdio.h>
#include "rv32_audio.h"

int main(void)
{
    rv32_audio_t device = rv32_audio_new(0);

    if (!rv32_audio_valid(device)) {
        return 1;
    }

    (void)rv32_audio_playback_depth(device);
    puts("AUDIO example: PASS");

    return 0;
}
