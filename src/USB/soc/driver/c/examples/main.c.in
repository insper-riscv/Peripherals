#include <stdio.h>
#include "rv32_usb.h"

int main(void)
{
    rv32_usb_t usb = rv32_usb_instance_new(0);

    if (!rv32_usb_valid(usb)) {
        return 1;
    }

    /* Read only the FPGA bridge; do not reset or enumerate attached devices. */
    (void)rv32_usb_bridge_status(usb);
    puts("USB example: PASS");

    return 0;
}
